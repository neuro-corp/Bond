  "agentDefaults": {
    "primaryModel": "nvidia/nemotron-3-ultra-550b-a55b:free",

    "fallbackModels": [
      "minimax/minimax-m3:free",
      "z-ai/glm-5.2:free",
      "cohere/north-mini-code:free",
      "poolside-ai/laguna-s-2.1:free",
      "openrouter/free"
    ],

    "codingModel": "cohere/north-mini-code:free",

    "reasoningModel": "z-ai/glm-5.2:free",

    "largeContextModel": "minimax/minimax-m3:free",

    "automaticModel": "openrouter/free"
  },

  "agentRequirements": {
    "minimumContextWindow": 32000,

    "preferredContextWindow": 128000,

    "requiredCapabilities": [
      "chat"
    ],

    "preferredCapabilities": [
      "tools",
      "function-calling",
      "reasoning"
    ]
  },

  "request": {
    "endpoint": "https://openrouter.ai/api/v1/chat/completions",
    "method": "POST",

    "headers": {
      "Authorization": "Bearer ${OPENROUTER_API_KEY}",
      "Content-Type": "application/json"
    },

    "body": {
      "model": "${model}",
      "messages": "${messages}",
      "stream": true,
      "tools": "${tools}",
      "tool_choice": "auto"
    }
  },

  "modelFetch": {
    "url": "https://openrouter.ai/api/v1/models",
    "method": "GET",

    "processing": {
      "freeCondition": "pricing.prompt == 0 && pricing.completion == 0",

      "recommendedCondition": [
        "architecture.modality contains text",
        "supported_parameters contains tools OR supported_parameters contains tool_choice",
        "context_length >= 32000"
      ]
    },

    "mapping": {
      "id": "id",
      "name": "name",
      "provider": "canonical_slug",
      "description": "description",
      "contextWindow": "context_length",
      "pricingInput": "pricing.prompt",
      "pricingOutput": "pricing.completion",
      "modalities": "architecture.input_modalities",
      "outputModalities": "architecture.output_modalities",
      "capabilities": "supported_parameters"
    }
  },

  "ui": {
    "showProvider": true,
    "showModelName": true,
    "showContextWindow": true,
    "showFreeBadge": true,
    "showCapabilities": true,
    "showLastUpdated": true,
    "allowModelSearch": true,
    "allowModelSort": true,
    "allowManualRefresh": true
  },

  "metadata": {
    "lastVerified": "2026-09-05",
    "catalogSource": "OpenRouter API",
    "pricing": "Free models only",
    "note": "Free models are rate-limited and availability can change. The IDE should refresh the catalog dynamically rather than relying only on this static list."
  }
}
